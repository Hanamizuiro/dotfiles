/* SwayNC config  */

@import "colors.css";

@define-color noti-border-color @outline;
@define-color noti-bg @surface_container;
@define-color noti-bg-alt @surface_container;
@define-color noti-bg-hover @surface_container_high;
@define-color text-color @on_surface;

@define-color text                  @on_surface;
@define-color background-alt  	    @primary_container;
@define-color background-alt-alpha  alpha(@primary_container, .75);
@define-color background-sec  	    alpha(@surface_container_high, 0.85);
@define-color selected        	    @primary;
@define-color accent                @primary_fixed_dim;
@define-color text-alt              @on_primary;
@define-color hover           	    alpha(@primary, .65);
@define-color urgent          	    @error;


* {
  font-family: "JetBrains Mono Nerd Font";
  font-weight: 500;
  font-size: 1rem;
}

.control-center .notification-row:focus,
.control-center .notification-row:hover {
  opacity: 1;
  background: alpha(@primary_container, 0.5);
  border-radius: 12px;
  transition: all 0.2s ease-in-out;
}

.notification-row {
  outline: none;
  margin: 5px 8px;
  transition: all 0.2s ease-in-out;
}

.notification {
  color: @on_surface;
  background: alpha(@surface_container_high, 0.95);
  padding: 12px;
  border-radius: 12px;
  border: 1px solid alpha(@primary, 0.3);
  box-shadow: 0 2px 8px alpha(@shadow, 0.2);
  transition: all 0.2s ease-in-out;
}

.notification:hover {
  border: 1px solid alpha(@primary, 0.6);
  box-shadow: 0 4px 12px alpha(@shadow, 0.3);
}

.notification-group {
  background-color: transparent;
  border-radius: 12px;
  margin: 4px 0;
}

.image {
  margin-right: 12px;
  margin-left: 12px;
  border-radius: 10px;
  padding: 0;
  border: 1px solid alpha(@primary, 0.2);
}

.close-button {
  background: transparent;
  color: @text;
  text-shadow: none;
  padding: 0;
  border-radius: 10px;
  margin-top: 5px;
  margin-right: 5px;
}

.close-button:hover {
  box-shadow: none;
  color: @on_primary;
  background-color: @primary;
  transition: all 0.15s ease-in-out;
  border: none;
}

.notification-action {
  border-top: none;
  border-radius: 10px;
  background: @primary_container;
  color: @primary;
  padding: 5px 10px;
  min-height: 0px; /* Remove GTK min height */
  min-width: 0px; /* Remove GTK min width */
  margin: 3px;
  border: 1px solid @primary;
}

.notification-action label {
  padding: 0px;
  margin: 0;
  font-size: 0.9rem;
  font-family: "JetBrains Mono Nerd Font";
  color: @primary;
}

.notification-default-action {
  margin: 0;
  padding: 0;
  font-size: 0.1rem;
  border-radius: 10px;
  background: @surface_container;
}
.notification-default-action:hover,
.notification-action:hover {
  color: @on_primary;
  background: @primary;
}

.notification-default-action:not(:only-child) {
  border-bottom-left-radius: 7px;
  border-bottom-right-radius: 7px;
}

.notification-action:first-child {
  border-bottom-left-radius: 10px;
  background: @primary_container;
  border: 1px solid @primary;
}

.notification-action:last-child {
  border-bottom-right-radius: 10px;
  background: @primary_container;
  border: 1px solid @primary;
}

.inline-reply {
  margin-top: 8px;
}

.inline-reply-entry {
  background: @surface_container;
  color: @on_surface;
  caret-color: @on_surface;
  border: 1px solid @surface_container;
  border-radius: 10px;
}

.inline-reply-button {
  font-size: 0.5rem;
  margin-left: 4px;
  background: @surface_container;
  border: 1px solid @surface_container;
  border-radius: 10px;
  color: @on_surface;
}

.inline-reply-button:disabled {
  background: initial;
  color: @on_surface;
  border: 1px solid transparent;
}

.inline-reply-button:hover {
  background: @hover;
}

.body-image {
  margin-top: 6px;
  color: @on_surface;
  border-radius: 10px;
}

.summary {
  font-size: 0.9rem;
  /* font-weight: bold; */
  background: transparent;
  color: @on_surface;
  text-shadow: none;
}

.time {
  font-size: 0.8rem;
  /* font-weight: bold; */
  background: transparent;
  color: @on_surface_variant;
  text-shadow: none;
  margin-right: 18px;
}

.body {
  font-size: 0.8rem;
  /* font-weight: bold; */
  background: transparent;
  color: @on_surface;
  text-shadow: none;
}

.control-center {
  background: alpha(@surface, 0.95);
  border: 1px solid @primary;
  color: @on_surface;
  border-radius: 10px;
}

.control-center-list {
  background: transparent;
}

.control-center-list-placeholder {
  opacity: 0.5;
}

.floating-notifications {
  background: transparent;
}

.blank-window {
  background: alpha(black, 0.1);
}

.widget-title {
  color: @on_primary_container;
  background: @primary_container;
  padding: 3px 6px;
  margin: 5px;
  font-size: 1rem;
  border-radius: 10px;
}

.widget-title > button {
  font-size: 0.75rem;
  color: @on_primary_container;
  border-radius: 10px;
  background: alpha(@primary, 0.3);
  border: 0.5px solid @primary;
}

/* clear button */
.widget-title > button:hover {
  background: @primary;
  color: @on_primary;
}

.widget-dnd {
  background: @primary_container;
  padding: 3px 6px;
  margin: 5px;
  border-radius: 12px;
  font-size: 0.5rem;
  color: @primary;
}

.widget-dnd > label {
  color: @primary;
}

.widget-dnd > switch {
  border-radius: 12px;
  border: 1px solid @primary;
  background: @surface_container_high;
}

.widget-dnd > switch:checked {
  background: @primary;
  border: 1px solid @primary;
}

.widget-dnd > switch slider {
  background: @primary;
  border-radius: 12px;
}

.widget-dnd > switch:checked slider {
  background: @on_primary;
  border-radius: 12px;
}

.widget-label {
  margin: 5px;
}

.widget-label > label {
  font-size: 1rem;
  color: @primary;
}

.widget-mpris {
  color: @on_primary_container;
  background: alpha(@primary_container, .8);
  padding: 3px 6px;
  margin: 5px;
  border-radius: 10px;
}

.widget-mpris > box > button {
  border-radius: 10px;
}

.widget-mpris-player {
  margin: 5px;
}

.widget-mpris-title {
  font-weight: 400;
  font-size: 1rem;
}

.widget-mpris-subtitle {
  font-size: 0.75rem;
}

.widget-buttons-grid {
  font-size: large;
  color: @on_primary_container;
  padding: 2px;
  margin: 5px;
  border-radius: 10px;
  background: @primary_container;
}

.widget-buttons-grid > flowbox > flowboxchild > button {
  margin: 1px;
  background: alpha(@primary, 0.3);
  border-radius: 10px;
  color: @on_primary_container;
  border: 1px solid alpha(@primary, 0.5);
}

/* individual buttons */
.widget-buttons-grid > flowbox > flowboxchild > button:hover {
  background: @primary;
  color: @on_primary;
}

.widget-menubar > box > .menu-button-bar > button {
  border: none;
  background: transparent;
  color: @on_primary_container;
}

.widget-menubar > box > .menu-button-bar > button:hover {
  background: alpha(@primary, 0.3);
  color: @primary;
}

.topbar-buttons > button {
  border: none;
  background: transparent;
  color: @on_surface;
}

.topbar-buttons > button:hover {
  background: @hover;
  color: @on_primary;
}

.notification.low progress,
.notification.normal progress {
  background-color: @primary;
  border-radius: 12.6px;
}
