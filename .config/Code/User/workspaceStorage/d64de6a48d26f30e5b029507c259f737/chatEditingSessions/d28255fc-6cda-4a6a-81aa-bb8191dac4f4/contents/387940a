/* Master Config */

/* ---- Configuration ---- */

/* ---- Load Matugen Material-3 colors ---- */
@import "colors.rasi"

configuration {
	modi:                       "drun,run,filebrowser";
    show-icons:                 true;
    display-drun:               "Apps";
    display-run:                "Run";
    display-filebrowser:        "Files";
    display-window:             "Windows";
  	drun-display-format:        "{name}";
	  hover-select:               true;
	  me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";
	  window-format:              "{w} · {c} · {t}";
	  dpi:						1;
}



/* ---- Global Properties ---- */
* {
    /* Base colors */
    background-alt:              @surface-container; 
    selected:                    @primary;
    active:                      @primary-container;
    urgent:                      @tertiary-container;

    /* Text colors */
    text-selected:               @on-primary;
    text-color:                  @on-surface;
    border-color:                @outline-variant;

    /* Additional semantic colors */
    accent:                      @primary;
    accent-alt:                  @secondary;
}

/* ---- Window ---- */
window {
    // Default
    enabled:                    true;
    fullscreen:                 false;
    transparency:               "real";
    cursor:                     "default";
    spacing:                    0px;
    border:                     2px solid;
    border-color:               @outline-variant;
    border-radius:              16px;
    location:                   center;
    anchor:                     center;

    // Style Values
    width:                      44%;
    background-color:           @surface-container-lowest;
}

/* ----- Main Box ----- */
mainbox {
    padding:                     12px;
    enabled:                     true;
    orientation:                 vertical;
    children:                    [ "inputbar", "listbox" ];
    background-color:            transparent;
}


/* ---- Inputbar ---- */
inputbar {
    enabled:                     true;
    padding:                     8px;
    margin:                      0px 0px 8px 0px;
    background-color:            @surface-container;
    border-radius:               12px;
    orientation:                 horizontal;
    children:                    ["entry", "dummy", "mode-switcher" ];
}

/* ---- Entry input ---- */
entry {
    font:                        "JetBrainsMono Nerd Font 13";
    enabled:                     true;
    expand:                      true;
    width:                       300px;
    padding:                     8px 12px;
    border-radius:               8px;
    background-color:            @surface-container-high;
    text-color:                  @on-surface;
    cursor:                      text;
    placeholder:                 "  Search...";
    placeholder-color:           @outline;
}

/* ---- Listbox ---- */
listbox {
    spacing:                     8px;
    padding:                     8px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    ["listview" ];
}

/* ---- Listview ---- */
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       10;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   true;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                false;
    fixed-columns:               true;    
    spacing:                     4px;
    padding:                     4px;
    background-color:            transparent;
    border:                      0px;
}

/* ---- Dummy ---- */
dummy {
    expand:                      true;
    background-color:            transparent;
}

/* ---- Mode Switcher ---- */
mode-switcher {
    enabled:                     true;
    spacing:                     8px;
    background-color:            transparent;
}
button {
    padding:                     6px 12px;
    border-radius:               8px;
    background-color:            @surface-container-high;
    text-color:                  @on-surface-variant;
    cursor:                      pointer;
}
button selected {
    background-color:            @primary;
    text-color:                  @on-primary;
}

/* ---- Scrollbar ---- */
scrollbar {
    width:                       6px;
    border:                      0;
    handle-color:                @primary;
    handle-width:                6px;
    padding:                     2px;
    border-radius:               6px;
    background-color:            @surface-container;
}

/* ---- Elements ---- */
element {
    enabled:                     true;
    spacing:                     12px;
    padding:                     10px 12px;
    border-radius:               10px;
    background-color:            transparent;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            inherit;
    text-color:                  inherit;
}
element normal.urgent {
    background-color:            @tertiary-container;
    text-color:                  @on-tertiary-container;
}
element normal.active {
    background-color:            @primary-container;
    text-color:                  @on-primary-container;
}

element selected.normal {
    background-color:            @primary;
    text-color:                  @on-primary;
}
element selected.urgent {
    background-color:            @tertiary-container;
    text-color:                  @on-tertiary-container;
}
element selected.active {
    background-color:            @tertiary-container;
    text-color:                  @on-tertiary-container;
}
// Adapt rofi theme
element alternate.normal {
    background-color:            transparent;
    text-color:                  inherit;
}
element alternate.urgent {
    background-color:            transparent;
    text-color:                  inherit;
}
element alternate.active {
    background-color:            transparent;
    text-color:                  inherit;
}
element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        24px;
    cursor:                      inherit;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;

}

/* ---- Message ---- */
message {
    background-color:            transparent;
    border:                      0px;
    margin:                      8px 0px;
}
textbox {
    padding:                     10px 14px;
    border-radius:               10px;
    background-color:            @surface-container;
    text-color:                  @on-surface;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
error-message {
    padding:                     14px;
    border-radius:               12px;
    background-color:            @error-container;
    text-color:                  @on-error-container;
}
