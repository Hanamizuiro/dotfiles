/*-----------IMPORTING MATUGEN COLORS----------*/
@import "colors.css";


* {
    font-size: 12px;
    font-family: GeistMono Nerd Font Propo;
    font-weight: bold;
}
window#waybar{
    all:unset;
}
.modules-left {
    padding: 7px;
    margin: 10px 0px 5px 10px;
    border-radius: 10px;
    background: alpha(@background,.6);
    box-shadow: 0px 0px 2px rgba(0, 0, 0, .6);
}
.modules-center {
    padding: 7px;
    margin: 10px 0px 5px 0px;
    border-radius: 10px;
    background: alpha(@background,.6);
    box-shadow: 0px 0px 2px rgba(0, 0, 0, .6);
}
.modules-right {
    padding:7px;
    margin: 10px 10px 5px 0px;
    border-radius: 10px;
    background: alpha(@background,.6);
    box-shadow: 0px 0px 2px rgba(0, 0, 0, .6);
}
tooltip {
    background: @background;
    border: 2px solid @primary;
    border-radius: 12px;
}
tooltip-label {
    color: @on_surface;
    padding: 5px;
}
#clock:hover, #custom-pacman:hover, #custom-notification:hover,#bluetooth:hover,#network:hover,#battery:hover, #cpu:hover,#memory:hover,#temperature:hover{
    transition: all .3s ease;
    color: @tertiary;
}
#custom-notification {
    padding: 0px 5px;
    transition: all .3s ease;
    color: @on_surface;
}
#clock{
    padding: 0px 5px;
    color: @on_surface;
    transition: all .3s ease;
}
#custom-pacman{
    padding: 0px 5px;
    transition: all .3s ease;
    color: @on_surface;

}
#workspaces {
    padding: 0px 5px;
}
#workspaces button {
    all:unset;
    padding: 0px 5px;
    color: alpha(@primary,.4);
    transition: all .2s ease;
}
#workspaces button:hover {
    color:rgba(0,0,0,0);
    border: none;
    text-shadow: 0px 0px 1.5px rgba(0, 0, 0, .5);
    transition: all 1s ease;
}
#workspaces button.active {
    color: @primary;
    border: none;
    text-shadow: 0px 0px 2px rgba(0, 0, 0, .5);
}
#workspaces button.empty {
    color: rgba(0,0,0,0);
    border: none;
    text-shadow: 0px 0px 1.5px rgba(0, 0, 0, .2);
}
#workspaces button.empty:hover {
    color: rgba(0,0,0,0);
    border: none;
    text-shadow: 0px 0px 1.5px rgba(0, 0, 0, .5);
    transition: all 1s ease;
}
#workspaces button.empty.active {
    color: @on_surface;
    border: none;
    text-shadow: 0px 0px 2px rgba(0, 0, 0, .5);
}
#bluetooth{
    padding: 0px 5px;
    transition: all .3s ease;
    color: @on_surface;

}
#network{
    padding: 0px 5px;
    transition: all .3s ease;
    color: @on_surface;

}

#custom-weather {
    padding: 0px 5px;
    transition: all .3s ease;
    color: @on_surface;
}

#battery{
    padding: 0px 5px;
    transition: all .3s ease;
    color: @on_surface;
}
#battery.charging {
    color: @tertiary;
}

#battery.warning:not(.charging) {
    color: @error;
}

#battery.critical:not(.charging) {
    color: @error_container;
    animation-name: blink;
    animation-duration: 0.5s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-direction: alternate;
}
#group-expand{
    padding: 0px 5px;
    transition: all .3s ease; 
}
#custom-expand{
    padding: 0px 5px;
    color: alpha(@on_surface,.2);
    text-shadow: 0px 0px 2px rgba(0, 0, 0, .7);
    transition: all .3s ease; 
}
#custom-expand:hover{
    color: alpha(@primary, .6);
    text-shadow: 0px 0px 2px alpha(@primary, .8);
}
#custom-colorpicker{
    padding: 0px 5px;
}
#cpu,#memory,#temperature{
    padding: 0px 5px;
    transition: all .3s ease; 
    color: @on_surface;

}
#custom-endpoint{
    color:transparent;
    text-shadow: 0px 0px 1.5px rgba(0, 0, 0, 1);

}
#tray{
    padding: 0px 5px;
    transition: all .3s ease; 

}
#tray menu * {
    padding: 0px 5px;
    transition: all .3s ease; 
}

#tray menu separator {
    padding: 0px 5px;
    transition: all .3s ease; 
}

#custom-cava_mviz {
  color: @primary;
}

/* Update these color assignments for better Matugen integration */

#idle_inhibitor {
    color: @cyan;
    padding: 0px 5px;
    transition: all .3s ease;
}

#backlight {
    color: @blue;
    padding: 0px 5px;
    transition: all .3s ease;
}

@keyframes blink {
    to {
        color: @background;
    }
}

#custom-keyboard {
    color: @cyan;
    padding: 0px 5px;
    transition: all .3s ease;
}

#disk {
    color: @blue_container;
    padding: 0px 5px;
    transition: all .3s ease;
}

#temperature.critical {
    background-color: @error_container;
    color: @on_error_container;
}

#keyboard-state {
    color: @magenta;
    padding: 0px 5px;
    transition: all .3s ease;
}

#taskbar button.active {
    padding-left: 8px;
    padding-right: 8px;
    color: @primary;
    transition: all 0.3s cubic-bezier(0.55, -0.68, 0.48, 1.682);
}

#taskbar button:hover {
    padding-left: 2px;
    padding-right: 2px;
    color: @on_primary_container;
    transition: all 0.3s cubic-bezier(0.55, -0.68, 0.48, 1.682);
}

#custom-menu {
    color: @cyan;
    padding: 0px 5px;
    transition: all .3s ease;
}

#custom-power {
    color: @error;
    padding: 0px 5px;
    transition: all .3s ease;
}

#custom-updater {
    color: @error;
    padding: 0px 5px;
    transition: all .3s ease;
}

#custom-light_dark {
    color: @blue;
    padding: 0px 5px;
    transition: all .3s ease;
}

#custom-lock {
    color: @magenta_container;
    padding: 0px 5px;
    transition: all .3s ease;
}

#pulseaudio {
    color: @green;
    padding: 0px 5px;
    transition: all .3s ease;
}

#pulseaudio.bluetooth {
    color: @magenta;
}

#pulseaudio.muted {
    color: @error;
}

#window {
    color: @blue_container;
    padding: 0px 5px;
    transition: all .3s ease;
}

#custom-waybar-mpris {
    color: @magenta;
    padding: 0px 5px;
    transition: all .3s ease;
}

#network.disconnected,
#network.disabled {
    background-color: @error_container;
    color: @on_error_container;
}

#pulseaudio-slider trough {
    min-width: 80px;
    min-height: 5px;
    border-radius: 5px;
    background-color: @surface_container;
}

#pulseaudio-slider highlight {
    min-height: 10px;
    border-radius: 5px;
    background-color: @primary;
}

#backlight-slider trough {
    min-width: 80px;
    min-height: 10px;
    border-radius: 5px;
    background-color: @surface_container;
}

#backlight-slider highlight {
    min-width: 10px;
    border-radius: 5px;
    background-color: @blue;
}
