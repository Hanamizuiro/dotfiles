{
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  "files.autoSave": "afterDelay",
  "explorer.expandSingleFolderWorkspaces": false,
  "github.copilot.nextEditSuggestions.enabled": true,
  "workbench.colorTheme": "Wal Bordered",
  "workbench.iconTheme": "material-icon-theme",
  "editor.fontFamily": "'Fira Code', 'FiraCode Nerd Font', monospace",
  "editor.fontLigatures": true,
  "editor.fontWeight": "400",
  "editor.fontSize": 16,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.guides.indentation": true,
  "editor.renderLineHighlight": "all",
  "editor.renderWhitespace": "selection",
  "editor.wordWrap": "on",
  "editor.cursorBlinking": "smooth",          // 
  "editor.cursorSmoothCaretAnimation": "on", 
  "editor.cursorStyle": "line-thin",
  "editor.smoothScrolling": true,
  "editor.mouseWheelZoom": true,
  "editor.minimap.enabled": true,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.maxColumn": 120,
  "editor.scrollBeyondLastLine": false,
  "explorer.compactFolders": false,
  "window.titleBarStyle": "custom",
  "window.dialogStyle": "custom",
  "workbench.layoutControl.enabled": true,
  "terminal.integrated.fontFamily": "'FiraCode Nerd Font Mono', monospace",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "underline",
  "terminal.integrated.scrollback": 10000,
  "editor.inlineSuggest.fontFamily": "Fira Code",
  "editor.inlineSuggest.enabled": true,
  "workbench.startupEditor": "none",
  "breadcrumbs.enabled": true,
  "window.zoomLevel": 0
}
