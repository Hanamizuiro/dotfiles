# : Manager [[[

[manager]
cwd = { fg = "#e0e4db" }

# Tab
tab_active = { fg = "#043912", bg = "#9ed49d", bold = true }
tab_inactive = { fg = "#b9f0b7", bg = "#002107" }
tab_width = 1

# Find
find_keyword = { fg = "#ffb4ab", bold = true, italic = true, underline = true }
find_position = { fg = "#ffb4ab", bold = true, italic = true }

# Marker
marker_copied = { fg = "#67d2e1", bg = "#67d2e1" }
marker_cut = { fg = "#bcebf2", bg = "#bcebf2" }
marker_marked = { fg = "#ffb4ab", bg = "#ffb4ab" }
marker_selected = { fg = "#a1ced6", bg = "#a1ced6" }

# Count
count_copied = { fg = "#001f23", bg = "#bcebf2" }
count_cut = { fg = "#001f23", bg = "#bcebf2" }
count_selected = { fg = "#043912", bg = "#a1ced6" }

# Border
border_symbol = "│"
border_style  = { fg = "#9ed49d" }

# : ]]]


# : Status [[[

[status]
separator_open = "🭁"
separator_close = "🭠"
separator_style = { bg = "#043912", fg = "#F4A261" }

[mode]
# Mode
normal_main = { bg = "#9ed49d", fg = "#043912", bold = true }
normal_alt  = { bg = "#424940", fg = "#c2c9bd" }

# Select mode
select_main = { bg = "#b9ccb5", fg = "#243424", bold = true }
select_alt  = { bg = "#424940", fg = "#c2c9bd" }

# Unset mode
unset_main = { bg = "#a1ced6", fg = "#00363c", bold = true }
unset_alt  = { bg = "#424940", fg = "#c2c9bd" }

# Progress
progress_label = { bold = true }
progress_normal = { fg = "#9ed49d", bg = "#363a34" }
progress_error = { fg = "#ffb4ab", bg = "#363a34" }

# Permissions
permissions_t = { fg = "#66895f" }
permissions_w = { fg = "#438d9b" }
permissions_x = { fg = "#ff2b12" }
permissions_r = { fg = "#3cc5d9" }
permissions_s = { fg = "#3ed638" }

# : ]]]


# : Select [[[

[select]
border = { fg = "#9ed49d" }
active = { fg = "#a1ced6", bold = true }
inactive = {}

# : ]]]


# : Input [[[

[input]
border = { fg = "#9ed49d" }
value = { fg = "#e0e4db" }

# : ]]]


# : Completion [[[

[completion]
border = { fg = "#9ed49d", bg = "#043912" }

# : ]]]


# : Tasks [[[

[tasks]
border = { fg = "#9ed49d" }
title = {}
hovered = { fg = "#bcebf2", underline = true }

# : ]]]


# : Which [[[

[which]
cols = 3
mask = { bg = "#363a34" }
cand = { fg = "#9ed49d" }
rest = { fg = "#043912" }
desc = { fg = "#e0e4db" }
separator = " ▶ "
separator_style = { fg = "#e0e4db" }

# : ]]]


# : Help [[[

[help]
on = { fg = "#e0e4db" }
run = { fg = "#e0e4db" }
footer = { fg = "#243424", bg = "#b9ccb5" }

# : ]]]


# : Notify [[[

[notify]
title_info = { fg = "#a1ced6" }
title_warn = { fg = "#9ed49d" }
title_error = { fg = "#ffb4ab" }

# : ]]]


# : File-specific styles [[[

[filetype]

rules = [
    # Images
    { mime = "image/*", fg = "#94e2d5" },

    # Media
    { mime = "{audio,video}/*", fg = "#f9e2af" },

    # Archives
    { mime = "application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "#f5c2e7" },

    # Documents
    { mime = "application/{pdf,doc,rtf}", fg = "#a6e3a1" },

    # Special files
    { name = "*", is = "orphan", bg = "#93000a" },
    { name = "*", is = "exec", fg = "#ffdad6" },

    # Fallback
    { name = "*", fg = "#e0e4db" },
    { name = "*/", fg = "#9ed49d" },
]

# : ]]]